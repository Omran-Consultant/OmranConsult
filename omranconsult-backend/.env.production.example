APP_NAME=OmranConsult
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db.internal.example
DB_PORT=3306
DB_DATABASE=omranconsult
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.example.com

SANCTUM_STATEFUL_DOMAINS=www.example.com
FRONTEND_URL=https://www.example.com

# Comma-separated production frontend egress IPs; empty means no bypass.
PUBLIC_READ_TRUSTED_IPS=

ADMIN_EMAIL=
ADMIN_PASSWORD=
