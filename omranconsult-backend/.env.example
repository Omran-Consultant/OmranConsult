APP_NAME=omranconsult
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MAMP MySQL 8 (SDD A11–A13). Port 8889 is env-specific; production uses host/vendor settings.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=8889
DB_DATABASE=omranconsult
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Phase 0+ Sanctum SPA (placeholders — configure in local .env only)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Shared secret for the Next.js server (`X-Omran-Frontend-Key`). Empty = 120/min per IP.
# Same value as the frontend FRONTEND_SERVER_KEY in `.env.local`. Never a NEXT_PUBLIC_* name.
FRONTEND_SERVER_KEY=

# Comma-separated frontend egress IPs that skip the public-read limiter. Empty = none.
PUBLIC_READ_TRUSTED_IPS=

# Bootstrap Super Admin (local .env only — never commit real values)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Phase 5 CMS: same value as the Next.js REVALIDATION_SECRET. Server-only.
REVALIDATION_SECRET=

# Public disk is used for CMS media uploads (storage/app/public).
# FILESYSTEM_DISK=local
