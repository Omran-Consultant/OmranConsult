# Server-only — used by Server Components and next.config rewrites (never NEXT_PUBLIC_*)
API_BASE_URL=http://localhost:8000

# Public site origin (Sanctum stateful domain must match browser origin: localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: browser calls Laravel directly (cross-origin CORS). Leave unset for same-origin
# /api and /sanctum rewrites through Next (recommended for Sanctum CSRF cookies).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
