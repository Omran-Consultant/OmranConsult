# Server-only — used by Server Components and next.config rewrites (never NEXT_PUBLIC_*)
API_BASE_URL=http://localhost:8000

# Public site origin (Sanctum stateful domain must match browser origin: localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: browser calls Laravel directly (cross-origin CORS). Leave unset for same-origin
# /api and /sanctum rewrites through Next (recommended for Sanctum CSRF cookies).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Leave unset (or false) locally and on previews: pages send noindex and robots.txt disallows all.
# Set true only in production, where the request host must also match NEXT_PUBLIC_SITE_URL.
# SITE_INDEXABLE=false

# Server-only shared secret for public API reads (same value as Laravel FRONTEND_SERVER_KEY).
# Locally put this in .env.local (Next.js standard). Never NEXT_PUBLIC_*.
# Empty means the Next server is limited to 120 public reads/min.
FRONTEND_SERVER_KEY=
