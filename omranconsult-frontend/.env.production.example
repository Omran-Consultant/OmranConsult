# Internal URL used only by the Next.js server.
API_BASE_URL=http://api.internal.example

# Canonical public website origin.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Leave unset when browser requests use the same-origin Next.js rewrites.
NEXT_PUBLIC_API_BASE_URL=

# Set to true ONLY on the production domain. Any other host (preview, tunnel, localhost) always
# sends X-Robots-Tag: noindex, nofollow and a disallow-all robots.txt, even if this is true.
# Canonical, hreflang, og:url, sitemap and robots always use NEXT_PUBLIC_SITE_URL.
SITE_INDEXABLE=true

# Server-only. Same value as the API FRONTEND_SERVER_KEY. Never NEXT_PUBLIC_*.
# Locally this lives in .env.local; in production it is a host environment variable.
FRONTEND_SERVER_KEY=
